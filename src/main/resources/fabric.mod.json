{
  "schemaVersion": 1,
  "id": "kaleidoscope_cookery",
  "version": "${version}",
  "name": "Kaleidoscope Cookery Fix (by FoliageOwO)",
  "description": "Cook all kinds of delicious food!",
  "authors": ["ysbb", "tartaric_acid", "NightEpiphany"],
  "contributors": ["chenjdy"],
  "contact": {
    "homepage": "https://modrinth.com/mod/kaleidoscope-cookery-refabricated",
    "sources": "https://github.com/NightEpiphany/KaleidoscopeCookery",
    "issues": "https://github.com/NightEpiphany/KaleidoscopeCookery/issues"
  },
  "license": "BSD-3-Clause + CC BY-NC-SA 4.0",
  "icon": "assets/kaleidoscope_cookery/cover.png",
  "environment": "*",
  "entrypoints": {
    "main": ["com.github.ysbbbbbb.kaleidoscopecookery.KaleidoscopeCookery"],
    "fabric-datagen": [
      "com.github.ysbbbbbb.kaleidoscopecookery.datagen.DataGenerators"
    ]
  },
  "mixins": ["kaleidoscope_cookery.mixins.json"],
  "accessWidener": "kaleidoscope_cookery.accesswidener",
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric": "*",
    "fabric-api": "*",
    "minecraft": "${minecraft_version}",
    "forgeconfigapiport": "*"
  },
  "suggests": {
    "jei": "*",
    "farmersdelight": ">=1.21.11-3.4.6+refabricated"
  },
  "breaks": {
    "farmersdelight": "<1.21.11-3.4.6+refabricated"
  }
}
